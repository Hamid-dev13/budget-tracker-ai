# uid/gid propriétaires de ./data sur l'hôte — le conteneur écrit avec cette identité.
# Générer avec : printf "APP_UID=%s\\nAPP_GID=%s\\n" "$(id -u)" "$(id -g)" > .env
APP_UID=1000
APP_GID=1000

# Interface sur laquelle publier le port. 127.0.0.1 par défaut (accès local seul).
# Sur un serveur, mettre l'IP Tailscale — jamais 0.0.0.0 : l'API accepte des
# écritures sans authentification et un POST /api/budget écrase tout le budget.
BIND_ADDR=127.0.0.1
